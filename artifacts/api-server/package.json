{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env ./scripts/dev.mjs",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps --env-file-if-exists=../../.env ./dist/index.mjs",
    "test:rides-concurrency": "node --env-file-if-exists=../../.env ./scripts/run-rides-concurrency-test.mjs",
    "test:driver-compliance": "node --experimental-strip-types --test tests/driver-compliance.test.mjs",
    "test:paystack-transfers": "node --experimental-strip-types --test tests/paystack-transfers.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "@google-cloud/storage": "^7.22.0",
    "@ngrok/ngrok": "^1.7.0",
    "@replit/object-storage": "^1.0.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
